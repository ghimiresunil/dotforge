{
    // ================================================================
    //  THEME & APPEARANCE  (Catppuccin theme + icons)
    // ================================================================
    "workbench.colorTheme": "Catppuccin Mocha",
    "workbench.iconTheme": "catppuccin-mocha",
    "catppuccin.accentColor": "mauve",
    "catppuccin.italicComments": true,
    "catppuccin.italicKeywords": true,
    "catppuccin.workbenchMode": "flat",
    "catppuccin.bracketMode": "rainbow",
    // ================================================================
    //  WINDOW & WORKBENCH LAYOUT
    // ================================================================
    "window.titleBarStyle": "custom",
    "window.commandCenter": true,
    "window.menuBarVisibility": "compact",
    "workbench.layoutControl.enabled": false,
    "workbench.activityBar.location": "top",
    "workbench.startupEditor": "none",
    "workbench.editor.empty.hint": "hidden",
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.labelFormat": "short",
    "workbench.editor.tabActionLocation": "left",
    "workbench.editor.pinnedTabsOnSeparateRow": true,
    "workbench.tree.indent": 16,
    "workbench.tree.renderIndentGuides": "onHover",
    "breadcrumbs.enabled": true,
    // ================================================================
    //  FONTS
    // ================================================================
    "editor.fontFamily": "'JetBrainsMono Nerd Font', 'Ubuntu Sans Mono', monospace",
    "editor.fontSize": 14,
    "editor.lineHeight": 1.7,
    "editor.fontLigatures": true,
    "editor.letterSpacing": 0.3,
    // ================================================================
    //  EDITOR LOOK & FEEL
    // ================================================================
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorWidth": 2,
    "editor.smoothScrolling": true,
    "workbench.list.smoothScrolling": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.stickyScroll.enabled": true,
    "editor.minimap.enabled": false,
    "editor.renderLineHighlight": "gutter",
    "editor.padding.top": 12,
    "editor.rulers": [
        88
    ],
    "editor.glyphMargin": false,
    "editor.folding": true,
    "editor.foldingHighlight": false,
    "editor.overviewRulerBorder": false,
    "editor.hideCursorInOverviewRuler": true,
    "editor.scrollbar.verticalScrollbarSize": 8,
    "editor.scrollbar.horizontalScrollbarSize": 8,
    "editor.linkedEditing": true,
    "editor.suggest.preview": true,
    "editor.inlineSuggest.enabled": true,
    "editor.inlayHints.enabled": "onUnlessPressed",
    "editor.accessibilitySupport": "off",
    // ================================================================
    //  FILES: clean up on save, hide ML/Python junk
    // ================================================================
    "files.autoSave": "onFocusChange",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/.ipynb_checkpoints": true,
        "**/*.egg-info": true
    },
    // Don't watch huge folders (big speedup in ML repos)
    "files.watcherExclude": {
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/data/**": true,
        "**/datasets/**": true,
        "**/checkpoints/**": true,
        "**/mlruns/**": true,
        "**/wandb/**": true,
        "**/outputs/**": true,
        "**/runs/**": true
    },
    "search.exclude": {
        "**/.venv": true,
        "**/venv": true,
        "**/data": true,
        "**/datasets": true,
        "**/checkpoints": true,
        "**/mlruns": true,
        "**/wandb": true,
        "**/*.ipynb_checkpoints": true
    },
    "files.associations": {
        "*.env*": "dotenv",
        "Dockerfile.*": "dockerfile",
        "*.Dockerfile": "dockerfile",
        "docker-compose*.yml": "dockercompose",
        "compose*.yaml": "dockercompose",
        "requirements*.txt": "pip-requirements"
    },
    // ================================================================
    //  PYTHON  (Pylance for intelligence, Ruff for lint + format)
    // ================================================================
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
        },
        "editor.tabSize": 4
    },
    "python.languageServer": "Pylance",
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.callArgumentNames": "partial",
    "python.analysis.inlayHints.pytestParameters": true,
    "python.terminal.activateEnvironment": true,
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    // ================================================================
    //  JUPYTER NOTEBOOKS
    // ================================================================
    "notebook.lineNumbers": "on",
    "notebook.formatOnSave.enabled": true,
    "notebook.codeActionsOnSave": {
        "notebook.source.fixAll": "explicit",
        "notebook.source.organizeImports": "explicit"
    },
    "notebook.output.scrolling": true,
    "notebook.output.textLineLimit": 60,
    "notebook.stickyScroll.enabled": true,
    "jupyter.askForKernelRestart": false,
    // ================================================================
    //  DOCKER / YAML / TOML / JSON / MARKDOWN
    // ================================================================
    "[dockerfile]": {
        "editor.tabSize": 4
    },
    "[dockercompose]": {
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[yaml]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml"
    },
    "[json][jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": true
    },
    "[markdown]": {
        "editor.wordWrap": "on"
    },
    // ================================================================
    //  TERMINAL
    // ================================================================
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font Mono', 'MesloLGS Nerd Font Mono', monospace",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.customGlyphs": false,
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.enablePersistentSessions": true,
    "terminal.integrated.stickyScroll.enabled": true,
    // ================================================================
    //  GIT
    // ================================================================
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "scm.diffDecorationsGutterWidth": 2,
    // ================================================================
    //  EXTENSIONS: Error Lens
    // ================================================================
    "errorLens.enabledDiagnosticLevels": [
        "error",
        "warning"
    ],
    "errorLens.delay": 500,
    // ================================================================
    //  EXTENSIONS: indent-rainbow (subtle Catppuccin-toned colors)
    // ================================================================
    "indentRainbow.colors": [
        "rgba(203,166,247,0.06)",
        "rgba(137,180,250,0.06)",
        "rgba(148,226,213,0.06)",
        "rgba(249,226,175,0.06)"
    ],
    "indentRainbow.errorColor": "rgba(243,139,168,0.25)",
    // ================================================================
    //  EXTENSIONS: Todo Tree
    // ================================================================
    "todo-tree.general.tags": [
        "TODO",
        "FIXME",
        "BUG",
        "HACK",
        "NOTE",
        "XXX"
    ],
    "todo-tree.highlights.defaultHighlight": {
        "type": "tag",
        "foreground": "#1e1e2e",
        "background": "#f9e2af",
        "opacity": 80
    },
    "todo-tree.tree.showCountsInTree": true,
    // ================================================================
    //  COPILOT / CHAT
    // ================================================================
    "github.copilot.nextEditSuggestions.enabled": true,
    "chat.viewSessions.orientation": "stacked",
    // ================================================================
    //  MISC
    // ================================================================
    "explorer.confirmDragAndDrop": false,
    "telemetry.telemetryLevel": "off",
    // Trusted JSON schema sources (fixes the Catppuccin "untrusted" warning)
    "json.schemaDownload.trustedDomains": {
        "https://json.schemastore.org/": true,
        "https://schemastore.azurewebsites.net/": true,
        "https://raw.githubusercontent.com/catppuccin/": true
    }
}
